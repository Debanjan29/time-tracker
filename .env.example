# Environment: development, staging, production
ENVIRONMENT=development

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg2://username:password@host:5432/dbname
# Cloud PostgreSQL examples (Neon, Supabase, Vercel Postgres, Render):
# DATABASE_URL=postgresql://user:password@ep-cool-db.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timelog_db

# Security & Authentication
# Secret key used for signing session/JWT cookies (generate with `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`)
AUTH_SECRET=change-this-to-a-secure-random-secret-key-at-least-32-chars

# Cookie configuration
# In production on HTTPS/Vercel, COOKIE_SECURE automatically defaults to true
COOKIE_NAME=timelog_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Allowed CORS origins (optional, comma-separated for custom domains)
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Environment: development, staging, production
ENVIRONMENT=development

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg2://username:password@localhost:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timelog_db

# Security & Authentication
# Secret key used for signing session/JWT cookies (generate with `openssl rand -hex 32` or python `secrets.token_hex(32)`)
AUTH_SECRET=change-this-to-a-secure-random-secret-key-at-least-32-chars

# Cookie configuration
COOKIE_NAME=timelog_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
